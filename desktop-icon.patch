diff --git a/build/installer.nsh b/build/installer.nsh
new file mode 100644
index 0000000..f50c3fe
--- /dev/null
+++ b/build/installer.nsh
@@ -0,0 +1,50 @@
+; Extra steps for the Windows installer. electron-builder includes this file on its
+; own because it sits in the build resources folder.
+;
+; It adds a page after the install-folder page with a "Create a desktop shortcut"
+; checkbox, ticked by default. The shortcut is only made if the box is still ticked,
+; and the uninstaller removes it either way. A silent install (/S) skips the page and
+; makes no desktop shortcut.
+
+!include nsDialogs.nsh
+!include LogicLib.nsh
+
+; The uninstaller is built in a separate pass that never shows this page.
+!ifndef BUILD_UNINSTALLER
+  Var DesktopShortcutBox
+  Var DesktopShortcutState
+
+  Function DesktopShortcutPageShow
+    nsDialogs::Create 1018
+    Pop $0
+    ${If} $0 == error
+      Abort
+    ${EndIf}
+    ${NSD_CreateLabel} 0 0 100% 24u "Choose additional shortcuts to create."
+    Pop $0
+    ${NSD_CreateCheckbox} 0 30u 100% 12u "Create a desktop shortcut"
+    Pop $DesktopShortcutBox
+    ${NSD_Check} $DesktopShortcutBox
+    nsDialogs::Show
+  FunctionEnd
+
+  Function DesktopShortcutPageLeave
+    ${NSD_GetState} $DesktopShortcutBox $DesktopShortcutState
+  FunctionEnd
+!endif
+
+!macro customPageAfterChangeDir
+  !ifndef BUILD_UNINSTALLER
+    Page custom DesktopShortcutPageShow DesktopShortcutPageLeave
+  !endif
+!macroend
+
+!macro customInstall
+  ${If} $DesktopShortcutState == ${BST_CHECKED}
+    CreateShortCut "$DESKTOP\${PRODUCT_NAME}.lnk" "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
+  ${EndIf}
+!macroend
+
+!macro customUnInstall
+  Delete "$DESKTOP\${PRODUCT_NAME}.lnk"
+!macroend
diff --git a/electron-builder.yml b/electron-builder.yml
index 1a634f4..9b15b46 100644
--- a/electron-builder.yml
+++ b/electron-builder.yml
@@ -12,7 +12,8 @@ copyright: Copyright © CaribouTuning and Turtle.GTI
 
 directories:
   output: release
-  # Optional: put icon.png (1024x1024) in build/ and every platform's icon is made from it.
+  # build/icon.png (1024x1024) is the source for every platform's icon; icon.svg is
+  # the original it was rendered from.
   buildResources: build
 
 files:
@@ -25,23 +26,30 @@ files:
 asar: true
 publish: null
 
+# File names carry no version on purpose: the release they are attached to already
+# names it, and a fixed name makes each file easy to recognise and to link to.
+# Every target is a plain file (no zips), so each one is visible on the release page.
+
 win:
   target:
     - { target: nsis, arch: [x64] }
     - { target: portable, arch: [x64] }
 nsis:
-  artifactName: ${productName}-Setup-${version}-${arch}.${ext}
+  artifactName: ECU-Lab-windows-installer.${ext}
   oneClick: false
   allowToChangeInstallationDirectory: true
+  # The installer asks about the desktop shortcut itself (build/installer.nsh), so the
+  # builder must not create one unconditionally.
+  createDesktopShortcut: false
+  createStartMenuShortcut: true
 portable:
